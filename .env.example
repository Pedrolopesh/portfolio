# Copie este arquivo para .env (ou .env.local) e preencha os valores reais.
# Nunca commite o .env de verdade — ele já está no .gitignore.

# Chave de API do Resend (https://resend.com), usada pelo endpoint
# /api/send para enviar o e-mail de contato.
RESEND_API_KEY=

# String de conexão do Postgres usada pelo blog (Fase 3).
# Ex.: postgresql://user:password@localhost:5432/portfolio
DATABASE_URL=
